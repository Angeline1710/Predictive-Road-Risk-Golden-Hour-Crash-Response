# Copy to .env for local (non-Docker) development. Docker Compose sets its
# own values in docker-compose.yml -- this file is for `uvicorn app.main:app`
# run directly against the Dockerized postgres/redis on localhost.

RRX_DATABASE_URL=postgresql+asyncpg://rrx:rrx@localhost:5432/rrx
RRX_REDIS_URL=redis://localhost:6379/0
RRX_GATEWAY=simulated
RRX_DEMO_MODE=true
RRX_JWT_SECRET=dev-only-change-me

# Left unset in every non-production deployment. Weather/traffic enrichment
# degrades gracefully (returns "unavailable") with no key configured --
# see app/services/enrichment.py.
# RRX_OPENWEATHER_API_KEY=
# RRX_TOMTOM_API_KEY=
