<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions listed here match PRD.md §12.1's "Key permissions" line
  exactly. INTERNET, ACCESS_FINE_LOCATION, ACTIVITY_RECOGNITION,
  FOREGROUND_SERVICE, FOREGROUND_SERVICE_LOCATION, and POST_NOTIFICATIONS
  are now exercised by core-sensing's Drive Mode. SEND_SMS,
  ACCESS_BACKGROUND_LOCATION, RECEIVE_BOOT_COMPLETED, and
  USE_FULL_SCREEN_INTENT are declared but not yet used. SEND_SMS and
  ACCESS_BACKGROUND_LOCATION need a Play Store permissions declaration
  with a demo video that is "a real, weeks-long gate" (PRD.md §12.1), so
  the manifest reflects the target surface area from day one rather than
  being patched permission-by-permission as the remaining tracks land.

  usesCleartextTraffic is true because the dev/demo backend
  (backend/docker-compose.yml) serves plain HTTP with no TLS termination;
  a real deployment needs HTTPS plus a network security config scoped to
  known hosts, not this blanket allowance.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".RrxApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rrx"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rrx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.rrx.coresensing.DriveSensingService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>

</manifest>
