<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions listed here match PRD.md §12.1's "Key permissions" line
  exactly. INTERNET, ACCESS_FINE_LOCATION, ACTIVITY_RECOGNITION,
  FOREGROUND_SERVICE, FOREGROUND_SERVICE_LOCATION, POST_NOTIFICATIONS, and
  USE_FULL_SCREEN_INTENT are now exercised (Drive Mode, transport, and the
  crash countdown screen's full-screen-intent notification). VIBRATE
  (2026-08-25) backs both CrashHapticController and the new
  RiskWarningController (UX-APPFLOW.md §14): Vibrator.vibrate() calls
  existed in the crash-flow code before this permission was ever declared,
  a pre-existing gap this closes for both call sites at once. SEND_SMS,
  ACCESS_BACKGROUND_LOCATION, and RECEIVE_BOOT_COMPLETED are declared but
  not yet used. SEND_SMS and ACCESS_BACKGROUND_LOCATION need a Play Store
  permissions declaration with a demo video that is "a real, weeks-long
  gate" (PRD.md §12.1), so the manifest reflects the target surface area
  from day one rather than being patched permission-by-permission as the
  remaining tracks land. USE_FULL_SCREEN_INTENT is a normal permission on
  API <34 but needs explicit user grant via Settings on API 34+; see
  CrashTriggerNotifier's fallback path when it isn't granted.

  usesCleartextTraffic is true because the dev/demo backend
  (backend/docker-compose.yml) serves plain HTTP with no TLS termination;
  a real deployment needs HTTPS plus a network security config scoped to
  known hosts, not this blanket allowance.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".RrxApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rrx"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rrx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name="com.rrx.coresensing.DriveSensingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- UX-APPFLOW.md §15: launched via a full-screen-intent
             notification so it can surface over the lock screen from a
             background foreground-service context, not just from
             in-app navigation. excludeFromRecents + singleTask: this
             screen represents a moment, not a destination; it shouldn't
             linger in the recents list or be re-enterable via back.
             Lock-screen display itself is set programmatically in
             CrashCountdownActivity.onCreate (setShowWhenLocked/
             setTurnScreenOn on API 27+, window flags below that);
             there is no manifest attribute for it. -->
        <activity
            android:name=".crash.CrashCountdownActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Rrx" />

        <!-- UX-APPFLOW.md §13. Launched manually from DriveSection, not
             automatically on IN_VEHICLE; see DriveModeActivity's own doc
             comment for why the automatic entry isn't wired. -->
        <activity
            android:name=".ui.drivemode.DriveModeActivity"
            android:exported="false"
            android:theme="@style/Theme.Rrx" />

    </application>

</manifest>
