<?xml version="1.0" encoding="utf-8"?>
<!--
  Permissions listed here match PRD.md §12.1's "Key permissions" line
  exactly. Only INTERNET is actually exercised by this scaffold's one real
  network call; the rest are declared now because SEND_SMS and
  ACCESS_BACKGROUND_LOCATION need a Play Store permissions declaration
  with a demo video that is "a real, weeks-long gate" (PRD.md §12.1), so
  the manifest should reflect the target surface area from day one rather
  than being patched permission-by-permission as sensing/transport land.
  None of them are runtime-requested yet; that belongs with the feature
  that actually needs the grant (core-sensing, notifications, etc).

  usesCleartextTraffic is true because the dev/demo backend
  (backend/docker-compose.yml) serves plain HTTP with no TLS termination;
  a real deployment needs HTTPS plus a network security config scoped to
  known hosts, not this blanket allowance.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".RrxApplication"
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.Rrx"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Rrx">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
